# biri-youyaku web 环境变量模板
# 复制：cp web/.env.example web/.env
# 改后需重启 npm run dev；生产 build 时由 CI/Vercel 注入。

# 后端 API 根地址（浏览器访问得到的 URL，不是容器内网名）
# 本机前后端：http://localhost:17821
# 远程 API（Tunnel 等）：https://api.example.com
VITE_API_BASE_URL=http://localhost:17821

# 与后端 API_TOKEN 一致；后端留空则这里也留空
# 注意：会打进前端 JS bundle，公网只能当弱共享口令，请叠 CF Access / Vercel Protection
VITE_API_TOKEN=
