# biri-youyaku server 环境变量模板
# 约定：开关与常用项一律显式写出（true/false 或具体值），与 config.py 默认一致。
# 复制：cp server/.env.example server/.env  再改本机值。完整说明见 CONFIG.md。

# ====== 必填（不配也能起服务，创建总结任务会失败）======
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash

# ====== 应用 / 鉴权 ======
APP_LOG_LEVEL=INFO
# 多个 origin 用逗号分隔；公网前端域名请追加进来
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 空 = 不校验 Bearer（仅本地）；公网务必：openssl rand -hex 32
API_TOKEN=

# ====== B 站（可选；私享 / 高画质字幕等再填）======
BILI_SESSDATA=
BILI_BUVID3=
BILI_BILI_JCT=

# ====== ASR（无官方字幕时才会用到；需 uv sync --extra asr 或 asr-mlx）======
# 云端 / Linux 生产镜像默认不装 asr extra；本机 Mac 可 asr-mlx。
# sensevoice | sensevoice-mlx | parakeet-mlx | faster-whisper | auto
# Linux 用 sensevoice；不要把 Mac 专用 mlx 模型名带到 ECS。
ASR_MODEL=sensevoice
ASR_DEVICE=auto
ASR_LANGUAGE_DEFAULT=auto
# 空 = 自动下载模型。云端勿复制 Mac 绝对路径（如 /Users/...）。
SENSEVOICE_MODEL_DIR=

# ====== LLM 调优 ======
# OpenRouter：仅管理 Key 能读账户 credits；普通推理 Key 只看自身限额
OPENROUTER_MANAGEMENT_API_KEY=
# 空 = 从本实例密钥派生指纹（不存原始 Key）；生产建议固定
USAGE_FINGERPRINT_SECRET=
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# 空 = 代码内默认温度（勿填非数字；留空即可）
LLM_TEMPERATURE=
LLM_CHUNK_TOKEN_THRESHOLD=30000
LLM_SEGMENT_CONCURRENCY=3
# 仅 deepseek-v4-*；开了更慢更费 token
LLM_THINKING_ENABLED=false
# SSRF 白名单（逗号分隔）。空 = 不限制（仅本地 dev）。生产请保持或收紧。
LLM_BASE_URL_ALLOWED_HOSTS=api.deepseek.com,api.moonshot.cn,open.bigmodel.cn,generativelanguage.googleapis.com,api.openai.com,api.anthropic.com,api.x.ai

# ====== 总结 / 周报 ======
SUMMARY_LANGUAGE=中文简体
WEEKLY_SUMMARY_TIMEZONE=Asia/Shanghai

# ====== 邮件（默认关；开之前必须配齐 URL / token / 收件人）======
EMAIL_ENABLED=false
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
EMAIL_DEFAULT_RECIPIENT=
EMAIL_SUBJECT_TEMPLATE=[Biri-Youyaku] {{title}}

# ====== 知识库（开关一律显式）======
# 登记总结产物；关则 register/reconcile 空操作
KNOWLEDGE_REGISTER_ENABLED=true
# 本地 FTS 检索（对外暴露还需 register 为 true）
KNOWLEDGE_SEARCH_ENABLED=true
# 问答：query+片段会发往 LLM，默认关（隐私/费用敏感时保持 false）
KNOWLEDGE_CHAT_ENABLED=false
# 原始字幕 FTS 层
KNOWLEDGE_TRANSCRIPT_INDEX_ENABLED=true
KNOWLEDGE_SOFT_DELETE_DAYS=30
# 相对 data/*：便携、利于 backup/restore 与换机；勿写死本机绝对路径
KNOWLEDGE_STORAGE_DIR=data/knowledge
KNOWLEDGE_BACKUP_DIR=data/backups

# ====== 存储路径（建议相对 data/*，便于备份迁移）======
AUDIO_STORAGE_DIR=data/audio
SUMMARY_STORAGE_DIR=data/summaries
DISTILL_STORAGE_DIR=data/distill
DB_PATH=data/biri_youyaku.db

# ====== 清理 / 维护 ======
AUDIO_RETENTION_DAYS=7
# 仅自动清 FAILED/CANCELED 且无 summary 的 job；COMPLETED 需用户手动删
JOB_RETENTION_DAYS=180
ORPHAN_FILE_RETENTION_DAYS=3
STALE_RUNNING_FAIL_HOURS=4
CLEANUP_INTERVAL_SECONDS=3600
WAL_CHECKPOINT_INTERVAL_HOURS=24
DB_VACUUM_INTERVAL_DAYS=30

# ====== 并发 ======
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_SUMMARIES=2
DISTILL_TRANSCRIPT_CONCURRENCY=3

# ====== 防滥用（公网建议按机器能力收紧）======
MAX_VIDEO_DURATION_SECONDS=14400
MAX_INFLIGHT_JOBS=20
